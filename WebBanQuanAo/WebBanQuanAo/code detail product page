                    $("#click-header-mobile").on('click',function(){
                                                let product_info_modal_mobile = $('#product_info_modal_mobile');
                        product_info_modal_mobile.css("display", "block");
                        product_info_modal_mobile.addClass("in");
                        product_info_modal_mobile.attr("aria-hidden","false");
                        let isValid = $('#product_addtocart_form').valid('isValid');
                        product_info_modal_mobile.css("display", "none");
                        product_info_modal_mobile.removeClass("in");
                        product_info_modal_mobile.attr("aria-hidden","true");
