@{
    ViewData["Title"] = "Đăng Nhập";
}

<style>
    
    .login-page {
        position: relative;
        width: 100vw;
        height: 100vh;
        background: #FFFFFF;
        border-radius: 24px;
        overflow: hidden;
    }
    
    .background-image {
        position: absolute;
        width: 100%;
        height: 100%;
        left: 0;
        top: 0;
        background: url('/images/woman-with-shopping-bags-studio-yellow-background-isolated.jpg') center/cover;
        background-size: cover;
    }
    
    .left-content {
        position: absolute;
        left: 121px;
        top: 50%;
        transform: translateY(-50%);
        z-index: 2;
    }
    
    .brand-name {
        font-family: 'Rawgly', sans-serif;
        font-weight: 400;
        font-size: 36px;
        line-height: 54px;
        color: #FFFFFF;
        margin-bottom: 200px;
    }
    
    .shop-title {
        font-family: 'Rebaston', sans-serif;
        font-weight: 400;
        font-size: 36px;
        line-height: 43px;
        color: #FFFFFF;
        margin-bottom: 67px;
    }
    
    .nav-menu {
        margin-bottom: 20px;
    }
    
    .nav-title {
        font-family: 'Poppins', sans-serif;
        font-weight: 700;
        font-size: 14px;
        line-height: 18px;
        color: #FFFFFF;
        margin-bottom: 20px;
    }
    
    .nav-item {
        font-family: 'Poppins', sans-serif;
        font-weight: 500;
        font-size: 14px;
        line-height: 18px;
        color: #FFFFFF;
        opacity: 0.5;
        margin-bottom: 20px;
        cursor: pointer;
        transition: opacity 0.3s;
    }
    
    .nav-item:hover {
        opacity: 1;
    }
    
    .right-panel {
        position: absolute;
        width: 388px;
        height: 100vh;
        right: 0;
        top: 0;
        background: rgba(0, 0, 0, 0.22);
        box-shadow: 0px 13px 44px rgba(0, 0, 0, 0.12);
        backdrop-filter: blur(9.8px);
    }
    
    .close-btn {
        position: absolute;
        width: 64px;
        height: 64px;
        right: 40px;
        top: 40px;
        cursor: pointer;
        color: #FFFFFF;
        font-size: 24px;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    
    .login-form {
        position: absolute;
        width: 305px;
        left: 50%;
        top: 158px;
        transform: translateX(-50%);
    }
    
    .welcome-title {
        font-family: 'Montserrat', sans-serif;
        font-weight: 700;
        font-size: 24px;
        line-height: 36px;
        text-transform: uppercase;
        color: #FFFFFF;
        text-align: center;
        margin-bottom: 40px;
    }
    
    .input-group {
        position: relative;
        margin-bottom: 40px;
    }
    
    .input-field {
        width: 100%;
        background: transparent;
        border: none;
        border-bottom: 1px dashed #FFFFFF;
        padding: 12px 0 12px 40px;
        font-family: 'Poppins', sans-serif;
        font-weight: 500;
        font-size: 14px;
        color: #FFFFFF;
        outline: none;
    }
    
    .input-field::placeholder {
        color: #FFFFFF;
        opacity: 0.6;
    }
    
    .input-icon {
        position: absolute;
        left: 0;
        top: 12px;
        width: 24px;
        height: 24px;
        color: #FFFFFF;
    }
    
    .continue-btn {
        width: 100%;
        height: 48px;
        background: #FFFFFF;
        box-shadow: 0px 16px 32px rgba(0, 158, 226, 0.1);
        border-radius: 24px;
        border: none;
        font-family: 'Montserrat', sans-serif;
        font-weight: 700;
        font-size: 16px;
        color: #1C1C1C;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        cursor: pointer;
        transition: all 0.3s;
        margin-bottom: 40px;
    }
    
    .continue-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0px 20px 40px rgba(0, 158, 226, 0.15);
    }
    
    .divider {
        position: relative;
        text-align: center;
        margin: 40px 0;
    }
    
    .divider::before {
        content: '';
        position: absolute;
        top: 50%;
        left: 0;
        right: 0;
        height: 1px;
        background: rgba(255, 255, 255, 0.2);
    }
    
    .divider span {
        background: rgba(0, 0, 0, 0.22);
        padding: 0 16px;
        font-family: 'Montserrat', sans-serif;
        font-weight: 500;
        font-size: 14px;
        color: #FFFFFF;
    }
    
    .social-login {
        display: flex;
        gap: 12px;
        justify-content: center;
        margin-bottom: 40px;
    }
    
    .social-btn {
        width: 54px;
        height: 54px;
        border: 1px solid #FFFFFF;
        border-radius: 50%;
        background: transparent;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all 0.3s;
        color: #FFFFFF;
        font-size: 20px;
    }
    
    .social-btn:hover {
        background: rgba(255, 255, 255, 0.1);
        transform: translateY(-2px);
    }
    
    .register-link {
        font-family: 'Poppins', sans-serif;
        font-weight: 500;
        font-size: 14px;
        color: #FFFFFF;
        text-align: center;
    }
    
    .register-link a {
        color: #FFFFFF;
        text-decoration: underline;
    }
    
    .alert {
        background: rgba(255, 255, 255, 0.1);
        border: 1px solid rgba(255, 255, 255, 0.2);
        border-radius: 12px;
        padding: 12px;
        margin-bottom: 20px;
        color: #FFFFFF;
        font-family: 'Poppins', sans-serif;
        font-size: 14px;
    }
    
    .alert-success {
        background: rgba(40, 167, 69, 0.2);
        border-color: rgba(40, 167, 69, 0.3);
    }
    
    .alert-danger {
        background: rgba(220, 53, 69, 0.2);
        border-color: rgba(220, 53, 69, 0.3);
    }
</style>

<div class="login-page">
    <!-- Background Image -->
    <div class="background-image"></div>
    
    <!-- Left Content -->
    <div class="left-content">
        <div class="brand-name">clubhouse</div>
        
        <div class="shop-title">Shop</div>
        
        <div class="nav-menu">
            <div class="nav-title">New Arrivals</div>
            <div class="nav-item">Women's</div>
            <div class="nav-item">Men's</div>
            <div class="nav-item">Kids</div>
            <div class="nav-item">Winters</div>
        </div>
    </div>
    
    <!-- Right Panel -->
    <div class="right-panel">
        <div class="close-btn">
            <i class="fas fa-times"></i>
        </div>
        
        <div class="login-form">
            <h1 class="welcome-title">existing member Welcome Back!</h1>
            
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success">
                    <i class="fas fa-check-circle mr-2"></i>@TempData["Success"]
                </div>
            }
            @if (ViewData.ModelState.Values.SelectMany(v => v.Errors).Any())
            {
                <div class="alert alert-danger">
                    <i class="fas fa-exclamation-circle mr-2"></i>
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <div>@error.ErrorMessage</div>
                    }
                </div>
            }
            
            <form method="post" asp-action="Login">
                <div class="input-group">
                    <i class="fas fa-envelope input-icon"></i>
                    <input type="text" name="username" class="input-field" placeholder="Jamesthomas@mail.com" required />
                </div>
                
                <div class="input-group">
                    <i class="fas fa-lock input-icon"></i>
                    <input type="password" name="password" class="input-field" placeholder="Enter Password" required />
                </div>
                
                <button type="submit" class="continue-btn">
                    Continue
                    <i class="fas fa-arrow-right"></i>
                </button>
            </form>
            
            <div class="divider">
                <span>OR</span>
            </div>
            
            <div class="social-login">
                <a href="@Url.Action("GoogleLogin", "Account")" class="social-btn">
                    <i class="fab fa-google"></i>
                </a>
                <button class="social-btn">
                    <i class="fab fa-facebook-f"></i>
                </button>
                <button class="social-btn">
                    <i class="fab fa-apple"></i>
                </button>
            </div>
            
            <div class="register-link">
                Don't have account? <a asp-action="Register">Register Now</a>
            </div>
        </div>
    </div>
</div>